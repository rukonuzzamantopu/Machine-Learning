      "5\n"
     ]
    }
   ],
   "source": [
    "inp = input()\n",
    "\n",
    "numbers = inp.split()\n",
    "\n",
    "x = int(numbers[0]) # 13\n",
    "\n",
    "y = int(numbers[1]) # 12 \n",
    "\n",
    "last_digit_of_x = x % 10 \n",
    "last_digit_of_y = y % 10 \n",
    "\n",
    "sum = last_digit_of_x + last_digit_of_y \n",
    "\n",
    "print(sum)"
   ]
  }
